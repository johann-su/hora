###
# Cluster specific settings
###

# --- cluster access -----------------------------------------------------------
# Login node used for rsync and sbatch. 
: "${CLUSTER_LOGIN:=joss478d@login1.capella.hpc.tu-dresden.de}"

# --- cluster paths ------------------------------------------------------------
# Workspace, not $HOME: the image alone is ~13 GB and Isaac Sim's caches are write-heavy. 
# Allocate with `ws_allocate -F horse hora <days>`.
: "${CLUSTER_WS:=/data/horse/ws/joss478d-hora}"
: "${CLUSTER_HORA_DIR:=${CLUSTER_WS}/hora}"
: "${CLUSTER_SIF_DIR:=${CLUSTER_WS}/sif}"
# Extra pip packages that are not in the image, installed to a bind mount because the SIF is read-only. 
# See setup_deps.sh.
: "${CLUSTER_PYDEPS_DIR:=${CLUSTER_WS}/pydeps}"
# Persistent copy of the Isaac Sim caches. Warm caches cut startup from several minutes to well under one, so these are worth keeping between jobs.
: "${CLUSTER_CACHE_DIR:=${CLUSTER_WS}/isaac-sim-cache}"

# --- image --------------------------------------------------------------------
# Prebuilt IsaacLab image on NGC. 2.3.1 pairs with Isaac Sim 5.1, matching environment_isaaclab.yaml on the host side.
: "${ISAACLAB_IMAGE:=nvcr.io/nvidia/isaac-lab:2.3.1}"
: "${SIF_NAME:=isaac-lab-2.3.1.sif}"
: "${CLUSTER_SIF:=${CLUSTER_SIF_DIR}/${SIF_NAME}}"

# --- paths inside the container ------------------------------------------------
# Fixed by the image (see IsaacLab docker/.env.base): Isaac Sim at /isaac-sim, IsaacLab at /workspace/isaaclab, container user home at /root.
: "${ISAACSIM_ROOT:=/isaac-sim}"
: "${CONTAINER_HORA:=/workspace/hora}"
: "${CONTAINER_PYDEPS:=/workspace/pydeps}"
# Isaac Sim ships its own interpreter with the whole stack on the path; the system `python3` in the image cannot import isaacsim.
: "${CONTAINER_PYTHON:=/isaac-sim/python.sh}"

# --- SLURM defaults -------------------------------------------------------------
# Capella nodes are 4x H100 / 64 cores / 773 GB, so one GPU's fair share is
# ~14 cores and ~180 GB. Override per submission, e.g.
#   HORA_TIME=23:00:00 HORA_MEM=240G ./scripts/hpc/submit.sh train_s1 0 hora_v1
: "${HORA_ACCOUNT:=p_lasr_students}"
: "${HORA_PARTITION:=capella}"
: "${HORA_GPUS:=1}"
: "${HORA_CPUS:=14}"
: "${HORA_MEM:=180G}"
: "${HORA_TIME:=08:00:00}"
